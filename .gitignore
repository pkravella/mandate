# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test and coverage
coverage/
.vitest/

# ---------------------------------------------------------------------------
# Secrets. This project handles GitHub App private keys and minted installation
# tokens. Do not relax these patterns.
# ---------------------------------------------------------------------------
*.pem
*.p8
*.key
*.cert
.env
.env.*
!.env.example
**/secrets.json
**/installation-token*

# Runtime artifacts. Action-graph traces record repository paths and output
# digests, so they are generated locally and never committed. Test fixtures
# under fixtures/ are checked in deliberately and are not matched here.
bench/out/
.mandate/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Private working documents.
#
# The PRD carries business-model and competitive material; the implementation
# plans are working documents; handoffs are session state. Everything ELSE
# under docs/ is public and committed -- SECURITY.md links to
# docs/enforced-where.md, so a blanket docs/* ignore would leave a public
# repository with a broken link to a file that can never exist in it.
mandate-prd.md
docs/superpowers/
docs/handoff/